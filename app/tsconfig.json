{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    // @opencode/ui ships its components as source and names the source before its types, so they
    // compile under these settings. They import types without `import type`, and use Promise.try
    // (ES2025), which Electron's Chromium has.
    "verbatimModuleSyntax": false,
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": ["src", "electron.vite.config.ts"],
  "exclude": ["src/**/*.test.ts"]
}
