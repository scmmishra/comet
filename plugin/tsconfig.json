{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": [
      "bun"
    ],
    "paths": {
      "@comet/plugin": [
        "./src/index.ts"
      ],
      "solid-js": [
        "./node_modules/solid-js"
      ],
      "solid-js/*": [
        "./node_modules/solid-js/*"
      ]
    }
  },
  "include": [
    "src",
    "../examples/plugins"
  ]
}
