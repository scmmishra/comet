#!/bin/bash
# Opens a folder in the installed Desk: `desk .` or `desk ~/code/repo`. It opens the link
# desk://open?dir=<folder>, which the system hands to the running Desk, or to the one it starts.
# `mise run install` installs Desk.
set -euo pipefail
folder="$(cd "${1:-.}" && pwd)"
app="/Applications/Desk.app"
if [ ! -d "$app" ]; then
  echo "Desk is not installed. Run \`mise run install\` in the Desk repo." >&2
  exit 1
fi
# Every byte but unreserved ones and slashes is escaped, so any folder name survives the link.
escaped="$(printf '%s' "$folder" | perl -pe 's/([^A-Za-z0-9\/._~-])/sprintf("%%%02X", ord($1))/ge')"
# -a names the installed app, so another Desk.app on the Mac, such as a build in dist, never takes the link.
exec open -a "$app" "desk://open?dir=$escaped"
